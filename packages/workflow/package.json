{
	"name": "dsh-workflow-plugin",
	"version": "0.2.1",
	"type": "module",
	"description": "Every DSH plugin of the k0ndrateff's collection in one install: Jira and Confluence, Sentry, GitLab, Figma, the digest, correlation, the Integrations page, project checks and the agent browser",
	"license": "MIT",
	"icon": "./icon.svg",
	"exports": {
		"./icon": "./icon.svg",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./locale/*.json": "./locale/*.json",
		"./package.json": "./package.json"
	},
	"files": [
		"cordis.patch.yml",
		"icon.svg",
		"locale/*.json"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"engines": {
		"dsh": ">=0.2.0 <0.3.0"
	},
	"scripts": {
		"build": "bun test test/patch.test.ts",
		"typecheck": "bun test test/patch.test.ts",
		"test": "bun test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"dsh-atlassian-plugin": "^0.4.0",
		"dsh-browser-plugin": "^0.2.0",
		"dsh-correlation-plugin": "^0.2.0",
		"dsh-devkit-plugin": "^0.2.0",
		"dsh-digest-plugin": "^0.2.0",
		"dsh-figma-plugin": "^0.2.0",
		"dsh-gitlab-plugin": "^0.3.0",
		"dsh-integrations-plugin": "^0.2.0",
		"dsh-sentry-plugin": "^0.2.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "k0ndrateff",
	"homepage": "https://github.com/k0ndrateff/dsh-plugins/tree/main/packages/workflow#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0ndrateff/dsh-plugins.git",
		"directory": "packages/workflow"
	}
}
