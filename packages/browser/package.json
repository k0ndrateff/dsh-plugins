{
	"name": "dsh-browser-plugin",
	"version": "0.1.3",
	"type": "module",
	"description": "A real browser for DeepSeek Harness: the agent opens, inspects and pokes a page in one browser per session, live in the side panel as it works",
	"license": "MIT",
	"main": "lib/index.js",
	"icon": "./icon.svg",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./icon": "./icon.svg",
		"./locale/*.json": "./locale/*.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"icon.svg",
		"locale/*.json"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-chat",
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-sidebar-right",
				"@deepseek-ai/dsh-client-ui-tool"
			]
		}
	},
	"engines": {
		"dsh": ">=0.2.0 <0.3.0"
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
		"test": "bun run test/config.ts && bun run test/envelope.ts && bun run test/feed.ts && bun run test/text.ts && bun run test/session.ts && bun run test/status.ts && bun run test/panel.ts && bun run test/input.ts && bun run test/wire.ts && bun run test/stream.ts && bun run test/runner.ts && bun run test/tools.ts",
		"test:live": "DSH_BROWSER_LIVE=1 bun run test/dry-run.ts",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@vanilla-extract/css": "^1.21.3"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-commands": "0.2.1-rc.2",
		"@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
		"@deepseek-ai/dsh-tools": "0.2.1-rc.2",
		"@deepseek-ai/dsh-working-directory": "0.2.1-rc.2"
	},
	"devDependencies": {
		"@deepseek-ai/schemastery": "^3.18.5",
		"dsh-integration-host": "^0.1.4",
		"dsh-integration-ui": "^0.1.4",
		"dsh-plugin-build": "^0.1.4"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "k0ndrateff",
	"homepage": "https://github.com/k0ndrateff/dsh-plugins/tree/main/packages/browser#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0ndrateff/dsh-plugins.git",
		"directory": "packages/browser"
	}
}
