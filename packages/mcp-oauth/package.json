{
	"name": "dsh-mcp-oauth",
	"version": "0.1.3",
	"type": "module",
	"description": "OAuth for MCP servers: discovery, dynamic client registration, PKCE, token lifetime, and the authenticated bridge",
	"license": "MIT",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./tool-name": {
			"types": "./lib/tool-name.d.ts",
			"default": "./lib/tool-name.js"
		}
	},
	"files": [
		"lib"
	],
	"scripts": {
		"build": "node build.mjs && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "bun run test/unit.ts && bun run test/bridge.ts && bun run test/conformance.ts",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "2.2.0"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
		"@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
		"@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
		"@deepseek-ai/dsh-tools": "0.2.1-rc.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "k0ndrateff",
	"homepage": "https://github.com/k0ndrateff/dsh-plugins/tree/main/packages/mcp-oauth#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0ndrateff/dsh-plugins.git",
		"directory": "packages/mcp-oauth"
	}
}
