{
	"name": "dsh-mcp-oauth",
	"version": "0.2.0",
	"type": "module",
	"description": "OAuth for MCP servers, and the authenticated bridge, for DeepSeek Harness — a library, not a plugin",
	"license": "MIT",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./tool-name": {
			"types": "./lib/tool-name.d.ts",
			"default": "./lib/tool-name.js"
		}
	},
	"files": [
		"lib"
	],
	"scripts": {
		"build": "node build.mjs && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "bun test",
		"test:live": "MCP_OAUTH_LIVE=1 bun test test/conformance.test.ts",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "2.2.0"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
		"@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
		"@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
		"@deepseek-ai/dsh-tools": "0.2.1-rc.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "k0ndrateff",
	"homepage": "https://github.com/k0ndrateff/dsh-plugins/tree/main/packages/mcp-oauth#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0ndrateff/dsh-plugins.git",
		"directory": "packages/mcp-oauth"
	}
}
