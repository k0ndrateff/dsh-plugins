{
	"name": "dsh-integration-host",
	"version": "0.4.1",
	"type": "module",
	"description": "The host-half shell the integrations of k0ndrateff/dsh-plugins share — a library, not a plugin",
	"license": "MIT",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./correlation": {
			"types": "./lib/correlation.d.ts",
			"default": "./lib/correlation.js"
		},
		"./digest": {
			"types": "./lib/digest.d.ts",
			"default": "./lib/digest.js"
		},
		"./status": {
			"types": "./lib/status.d.ts",
			"default": "./lib/status.js"
		},
		"./shape": {
			"types": "./lib/shape.d.ts",
			"default": "./lib/shape.js"
		}
	},
	"files": [
		"lib"
	],
	"scripts": {
		"build": "node build.mjs && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "bun test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"dsh-mcp-oauth": "^0.3.0"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-authorization": "0.2.1-rc.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "k0ndrateff",
	"homepage": "https://github.com/k0ndrateff/dsh-plugins/tree/main/packages/integration-host#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0ndrateff/dsh-plugins.git",
		"directory": "packages/integration-host"
	}
}
