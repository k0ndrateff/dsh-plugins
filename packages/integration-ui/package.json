{
	"name": "dsh-integration-ui",
	"version": "0.1.3",
	"type": "module",
	"description": "The browser-half shell the integrations of k0ndrateff/dsh-plugins share \u2014 a library, not a plugin",
	"license": "MIT",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./styles": {
			"types": "./lib/styles/index.d.ts",
			"default": "./lib/styles/index.js"
		}
	},
	"files": [
		"lib"
	],
	"scripts": {
		"build": "node build.mjs && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "bun run test/card.ts",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@vanilla-extract/css": "^1.21.3",
		"dsh-integration-host": "^0.1.3"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
		"react": "^18.2.0"
	},
	"devDependencies": {
		"@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "k0ndrateff",
	"homepage": "https://github.com/k0ndrateff/dsh-plugins/tree/main/packages/integration-ui#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0ndrateff/dsh-plugins.git",
		"directory": "packages/integration-ui"
	}
}
