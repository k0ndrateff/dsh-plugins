{
	"name": "dsh-atlassian-plugin",
	"version": "0.5.0",
	"type": "module",
	"description": "Jira and Confluence for DeepSeek Harness: the tools of Atlassian's remote MCP server, a result card, and the issue panel",
	"license": "MIT",
	"main": "lib/index.js",
	"icon": "./icon.svg",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./icon": "./icon.svg",
		"./locale/*.json": "./locale/*.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"icon.svg",
		"locale/*.json"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-client-ui-chat",
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-sidebar-right",
				"@deepseek-ai/dsh-client-ui-tool"
			]
		}
	},
	"engines": {
		"dsh": ">=0.2.0 <0.3.0"
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
		"test": "bun test",
		"prepack": "bun run build",
		"test:live": "ATLASSIAN_LIVE=1 bun test test/dry-run.test.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "2.2.0",
		"@vanilla-extract/css": "^1.21.3"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
		"@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
		"@deepseek-ai/dsh-llm": "0.2.1-rc.2",
		"@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
		"@deepseek-ai/dsh-tools": "0.2.1-rc.2"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-llm": {
			"optional": true
		}
	},
	"devDependencies": {
		"dsh-integration-host": "^0.4.0",
		"dsh-integration-ui": "^0.3.0",
		"dsh-mcp-oauth": "^0.3.0",
		"dsh-plugin-build": "^0.2.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "k0ndrateff",
	"homepage": "https://github.com/k0ndrateff/dsh-plugins/tree/main/packages/atlassian#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0ndrateff/dsh-plugins.git",
		"directory": "packages/atlassian"
	}
}
