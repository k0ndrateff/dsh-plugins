{
	"name": "dsh-correlation-plugin",
	"version": "0.1.0",
	"type": "module",
	"description": "Cross-provider correlation for DeepSeek Harness: an error, the commit behind it, the merge request it belongs to, and the ticket it names",
	"license": "MIT",
	"main": "lib/index.js",
	"icon": "./icon.svg",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./icon": "./icon.svg",
		"./locale/*.json": "./locale/*.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"icon.svg",
		"locale/*.json"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-chat",
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-tool"
			]
		}
	},
	"engines": {
		"dsh": ">=0.2.0 <0.3.0"
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
		"test": "bun run test/chain.ts && bun run test/tool.ts",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@vanilla-extract/css": "^1.21.3"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-tools": "0.2.1-rc.2"
	},
	"devDependencies": {
		"dsh-integration-host": "workspace:*",
		"dsh-integration-ui": "workspace:*",
		"dsh-plugin-build": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	},
	"author": "k0ndrateff",
	"homepage": "https://github.com/k0ndrateff/dsh-plugins/tree/main/packages/correlation#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/k0ndrateff/dsh-plugins.git",
		"directory": "packages/correlation"
	}
}
