{
	"name": "dsh-plugin-build",
	"version": "0.1.4",
	"type": "module",
	"description": "The build every plugin of k0ndrateff/dsh-plugins runs \u2014 a library, not a plugin",
	"license": "MIT",
	"main": "src/build.mjs",
	"exports": {
		".": "./src/build.mjs",
		"./package.json": "./package.json"
	},
