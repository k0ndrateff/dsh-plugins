{
	"name": "dsh-digest-plugin",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A read-only daily work digest assembled from Jira, GitLab and Sentry",
	"license": "MIT",
	"main": "lib/index.js",
	"icon": "./icon.svg",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js",
		"./icon": "./icon.svg",
		"./locale/*.json": "./locale/*.json"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"icon.svg",
		"locale/*.json"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-chat",
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-tool"
			]
		}
	},
	"engines": {
		"dsh": ">=0.2.0 <0.3.0"
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
		"test": "bun run test/settings.ts && bun run test/schedule.ts && bun run test/collect.ts && bun run test/command.ts"
	},
	"dependencies": {
		"@vanilla-extract/css": "^1.21.3"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-commands": "0.2.1-rc.2",
		"@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
		"@deepseek-ai/dsh-tools": "0.2.1-rc.2"
	},
	"devDependencies": {
		"dsh-integration-host": "workspace:*",
		"dsh-integration-ui": "workspace:*",
		"dsh-mcp-oauth": "workspace:*"
	}
}
