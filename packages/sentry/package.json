{
	"name": "dsh-sentry-plugin",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Sentry for DeepSeek Harness: OAuth sign-in and the tools of Sentry's remote MCP server",
	"license": "MIT",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js"
	},
	"files": [
		"lib",
		"cordis.patch.yml"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-chat",
				"@deepseek-ai/dsh-client-ui-conversation",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-sidebar-right",
				"@deepseek-ai/dsh-client-ui-tool"
			]
		}
	},
	"engines": {
		"dsh": ">=0.2.0 <0.3.0"
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
		"test": "bun run test/parse.ts && bun run test/surface.ts && bun run test/dry-run.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "2.2.0",
		"@vanilla-extract/css": "^1.21.3"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
		"@deepseek-ai/dsh-commands": "0.2.1-rc.2",
		"@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
		"@deepseek-ai/dsh-tools": "0.2.1-rc.2"
	},
	"devDependencies": {
		"dsh-mcp-oauth": "workspace:*"
	}
}
