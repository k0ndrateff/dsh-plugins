{
	"name": "dsh-plugins",
	"private": true,
	"type": "module",
	"description": "DeepSeek Harness plugins: Atlassian, and the OAuth library behind it",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"market": "bun run scripts/market/build.mjs",
		"changeset": "changeset",
		"version-packages": "changeset version && bun install",
		"release": "bun run market --check && changeset publish && bun run market",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "^3.0.3",
		"@deepseek-ai/cordis": "~4.0.5",
		"@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
		"@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-tool": "0.2.1-rc.2",
		"@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
		"@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
		"@deepseek-ai/dsh-fs": "0.2.1-rc.2",
		"@deepseek-ai/dsh-llm": "0.2.1-rc.2",
		"@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
		"@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.2",
		"@deepseek-ai/dsh-shell": "0.2.1-rc.2",
		"@deepseek-ai/dsh-tools": "0.2.1-rc.2",
		"@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
		"@types/node": "^26.6.5",
		"@types/react": "^18.3.12",
		"@vanilla-extract/esbuild-plugin": "^2.3.22",
		"esbuild": "^0.25.0",
		"semver": "^7.8.5",
		"typescript": "7"
	}
}
